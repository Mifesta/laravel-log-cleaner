{
  "name": "mifesta/laravel-log-cleaner",
  "description": "Artisan command for clearing Laravel log files.",
  "license": "MIT",
  "keywords": [
    "artisan",
    "clear",
    "laravel",
    "log"
  ],
  "authors": [
    {
      "name": "Sergei Gruzdov",
      "email": "cardee@mifesta.com",
      "homepage": "https://github.com/cardee2000",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/console": "^10.0",
    "illuminate/filesystem": "^10.0",
    "illuminate/support": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Mifesta\\LogCleaner\\": "src/"
    }
  },
  "scripts": {
    "test": "php tests/run.php"
  },
  "extra": {
    "laravel": {
      "aliases": {
        "LogCleaner": "Mifesta\\LogCleaner\\Facades\\Cleaner"
      },
      "providers": [
        "Mifesta\\LogCleaner\\LogCleanerServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  }
}
